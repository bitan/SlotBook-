APP_NAME=SlotBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slotbook
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=database
QUEUE_CONNECTION=database
SESSION_DRIVER=cookie
SESSION_LIFETIME=480

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@slotbook.app"
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Business default settings (seeded into settings table)
BUSINESS_NAME="My Business"
BUSINESS_PHONE=
BUSINESS_TIMEZONE=Africa/Addis_Ababa

# Booking rules
BOOKING_MIN_NOTICE_MINUTES=60
BOOKING_CANCEL_WINDOW_HOURS=2
BOOKING_AUTO_CONFIRM=true
