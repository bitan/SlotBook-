APP_NAME=SlotBook
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://slotbook-mia7.onrender.com
APP_TIMEZONE=UTC

FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/slotbook.sqlite

CACHE_DRIVER=database
QUEUE_CONNECTION=database
SESSION_DRIVER=cookie
SESSION_LIFETIME=480

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@slotbook.app"
MAIL_FROM_NAME="${APP_NAME}"

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Business default settings (seeded into settings table)
BUSINESS_NAME="My Business"
BUSINESS_PHONE=
BUSINESS_TIMEZONE=Africa/Addis_Ababa

# Booking rules
BOOKING_MIN_NOTICE_MINUTES=60
BOOKING_CANCEL_WINDOW_HOURS=2
BOOKING_AUTO_CONFIRM=true
